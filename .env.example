# Copy to .env.local. Never commit real credentials.
# Choose explicitly. DeepSeek uses prepaid API credit; Gemini retains its free-tier guard.
AI_PROVIDER=gemini
# For agentrouter.org set AI_PROVIDER=agentrouter. No automatic provider fallback.
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=deepseek-v4-flash
# Migration: agentrouter can use the existing DEEPSEEK_API_KEY slot if its own key is empty.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Confirm in AI Studio that this key's project has NO linked billing account.
# This is an operator declaration, not an automatic billing-account check.
FREE_TIER_CONFIRMED=false
PILOT_ACCESS_CODE=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
AUDITS_ENABLED=true
# Required on deployments; use the exact HTTPS origin without a trailing slash.
# Local development defaults to http://localhost:3000 and http://127.0.0.1:3000.
APP_ORIGIN=

# Optional individual accounts and shared rate limits. Keep pilot for examples
# and local development until the migration and hosted integration are verified.
AUTH_MODE=pilot
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use NEXT_PUBLIC_ for a secret key.
SUPABASE_SECRET_KEY=
SUPABASE_FREE_TIER_CONFIRMED=false

# Optional integration verifier: two dedicated, existing accounts with no saved work.
# Default verifier execution is a dry run. These values are never printed.
SUPABASE_TEST_A_EMAIL=
SUPABASE_TEST_A_PASSWORD=
SUPABASE_TEST_B_EMAIL=
SUPABASE_TEST_B_PASSWORD=
